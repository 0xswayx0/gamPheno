Package: gamPheno
Type: Package
Title: Posterior Extraction of Phenological Metrics from GAMs
Version: 0.7.0
Authors@R: c(
    person("Swantje", "Grabener", email = "swantje.grabener@leuphana.de", role = c("aut", "cre")),
    person("Claudia", "Drees", role = "aut"),
    person("Wiebke", "Schuett", role = "aut"),
    person("Michael", "Staab", role = "aut"),
    person("Pascale", "Zumstein", role = "aut"),
